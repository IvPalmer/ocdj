<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.grooveops.ocdj-traxdb-local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/palmer/bin/ocdj-traxdb-local.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- 15 min: new blog posts land every couple of days, so polling harder
         buys nothing and each cycle can pull gigabytes. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/palmer/Library/Logs/ocdj-traxdb-local.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/palmer/Library/Logs/ocdj-traxdb-local.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
