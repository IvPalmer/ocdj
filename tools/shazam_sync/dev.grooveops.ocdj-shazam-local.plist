<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.grooveops.ocdj-shazam-local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/palmer/bin/ocdj-shazam-local.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- 5 min: a cycle is one AppleScript read of a local playlist and, most
         of the time, no HTTP call at all. Cheap enough that a Shazam shows up
         in OCDJ while you're still standing in the room you heard it in. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/palmer/Library/Logs/ocdj-shazam-local.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/palmer/Library/Logs/ocdj-shazam-local.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
