# OCDJ environment variables
# Copy to .env and fill in your values. docs/INSTALL.md walks through it.

# REQUIRED. Folder on this computer that holds the music: the containers see
# it as /music. Downloads land in <folder>/Electronic/ID3/soulseek.
# Use forward slashes, also on Windows.
#   macOS:   OCDJ_MUSIC_DIR=/Users/you/Music/ocdj
#   Windows: OCDJ_MUSIC_DIR=C:/Users/you/Music/ocdj
OCDJ_MUSIC_DIR=

# Optional. Folder shared on the Soulseek network (mounted read-only).
# Default: <OCDJ_MUSIC_DIR>/Electronic/ID3/soulseek/collection
# SLSKD_SHARE_DIR=

# slskd API key (from slskd web UI > Settings > Security)
SLSKD_API_KEY=

# Dedicated Soulseek network account for slskd. Keep these values only in .env.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=

# AcoustID API key (https://acoustid.org/new-application)
ACOUSTID_API_KEY=

# Spotify (Phase 3+)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube downloader (yt-dlp). Authenticated cookies make YouTube treat the
# server as a signed-in user, which all but eliminates the intermittent
# "Sign in to confirm you're not a bot" challenge on datacenter IPs. If the
# cookies expire, yt-dlp falls back to anonymous access (still works most of
# the time). Prod mounts a Netscape cookies.txt at the path below (see the
# secrets bind mount in docker-compose.prod.yml); refresh it by re-exporting
# from a logged-in browser. YOUTUBE_PROXY is an optional egress override.
YOUTUBE_COOKIES=/srv/ocdj/secrets/youtube_cookies.txt
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_PROXY=
# PO-token provider sidecar (defeats YouTube's datacenter bot-check). Default
# points at the bgutil-pot compose service; leave as-is.
YOUTUBE_POT_BASE_URL=http://bgutil-pot:4416
# Residential fallback: when the VPS is bot-checked despite the PO token,
# yt-dlp retries through this proxy, which egresses via the home Mac's IP.
# Provided by the Mac-side reverse SOCKS tunnel (ocdj-yt-tunnel LaunchAgent).
YOUTUBE_MAC_PROXY=socks5://172.22.0.1:1080

# Telegram (Phase 3+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
